# Smartlead API Settings
SMARTLEAD_API_KEY=your_smartlead_api_key

# Target Campaign ID to monitor (or * for all campaigns)
CAMPAIGN_ID=3921933

# Recipients who will receive reply alerts (comma-separated)
RECIPIENT_EMAILS=user1@example.com,user2@example.com

# SMTP Settings
SMTP_HOST=smtp.migadu.com
SMTP_PORT=465
SMTP_USER=user@domain.com
SMTP_PASSWORD=your_password
SMTP_PASS=your_password
SENDER_EMAIL=user@domain.com
SENDER_NAME=Smartlead Reply Notifier

# Webhook Server Settings
WEBHOOK_PORT=5000
WEBHOOK_HOST=0.0.0.0
WEBHOOK_SECRET=
