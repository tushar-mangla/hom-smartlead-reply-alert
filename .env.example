# Smartlead API Settings
SMARTLEAD_API_KEY=your_smartlead_api_key_here

# Target Campaign ID to listen for (e.g. 123456 or * for all campaigns)
CAMPAIGN_ID=123456

# Recipients who will receive reply email alerts (comma-separated)
RECIPIENT_EMAILS=email1@example.com,email2@example.com,email3@example.com

# Email Sender SMTP Configuration (Gmail, Google Workspace, Outlook, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=Smartlead Reply Notifier

# Webhook Server Settings
WEBHOOK_PORT=5000
WEBHOOK_HOST=0.0.0.0
WEBHOOK_SECRET=
